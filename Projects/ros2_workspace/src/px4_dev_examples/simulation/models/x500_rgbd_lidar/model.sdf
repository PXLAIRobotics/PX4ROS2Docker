<?xml version="1.0"?>
<sdf version="1.9">
  <model name="x500_rgbd_lidar">
    <include merge="true"><uri>model://x500</uri></include>
    <link name="rgbd_link">
      <pose relative_to="base_link">0.20 0 0.08 0 0.1745329252 0</pose>
      <inertial><mass>0.07</mass><inertia><ixx>0.00004</ixx><iyy>0.00004</iyy><izz>0.00004</izz></inertia></inertial>
      <visual name="camera_body"><geometry><box><size>0.035 0.09 0.03</size></box></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      <collision name="camera_body"><geometry><box><size>0.035 0.09 0.03</size></box></geometry></collision>
      <sensor name="rgbd" type="rgbd_camera">
        <pose>0.02 0 0 0 0 0</pose>
        <gz_frame_id>rgbd_sensor</gz_frame_id>
        <topic>/drone/rgbd</topic><always_on>true</always_on><update_rate>10</update_rate>
        <camera>
          <optical_frame_id>rgbd_optical_frame</optical_frame_id>
          <horizontal_fov>1.5184364492</horizontal_fov>
          <image><width>320</width><height>240</height><format>R8G8B8</format></image>
          <clip><near>0.15</near><far>20</far></clip>
          <depth_camera><clip><near>0.15</near><far>20</far></clip></depth_camera>
        </camera>
      </sensor>
    </link>
    <joint name="rgbd_mount" type="fixed"><parent>base_link</parent><child>rgbd_link</child></joint>
    <link name="lidar_link">
      <pose relative_to="base_link">0 0 0.20 0 0 0</pose>
      <inertial><mass>0.15</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
      <visual name="lidar_body"><geometry><cylinder><radius>0.035</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.15 0.3 0.3 1</ambient><diffuse>0.15 0.3 0.3 1</diffuse></material></visual>
      <collision name="lidar_body"><geometry><cylinder><radius>0.035</radius><length>0.05</length></cylinder></geometry></collision>
      <sensor name="lidar_3d" type="gpu_lidar">
        <gz_frame_id>lidar_link</gz_frame_id>
        <topic>/drone/lidar</topic><always_on>true</always_on><update_rate>10</update_rate>
        <lidar><scan>
          <horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.1415926536</min_angle><max_angle>3.1415926536</max_angle></horizontal>
          <vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.2617993878</min_angle><max_angle>0.2617993878</max_angle></vertical>
        </scan><range><min>0.10</min><max>50</max><resolution>0.01</resolution></range></lidar>
      </sensor>
    </link>
    <joint name="lidar_mount" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>
  </model>
</sdf>
