#!/usr/bin/env bash
set -euo pipefail
headless=0; attach=1; gazebo_gui=1
export PX4_SENSOR_SUITE="${PX4_SENSOR_SUITE:-rgbd_lidar}"
export PX4_GZ_WORLD="${PX4_GZ_WORLD:-corda_campus}"
case "$PX4_SENSOR_SUITE" in rgbd_lidar|none) ;; *) echo 'PX4_SENSOR_SUITE must be rgbd_lidar or none.' >&2; exit 2;; esac
for argument in "$@"; do
    case "$argument" in
        --headless) headless=1 ;;
        --no-gazebo-gui) gazebo_gui=0 ;;
        --no-attach) attach=0 ;;
        *) echo 'Usage: start_px4_dev [--headless] [--no-gazebo-gui] [--no-attach]' >&2; exit 2 ;;
    esac
done
session=px4-dev
if tmux has-session -t "$session" 2>/dev/null; then
    if (( attach )) && [[ -t 0 ]]; then exec tmux attach -t "$session"; fi
    echo 'px4-dev already exists. Use tmux attach -t px4-dev or stop_px4_dev.' >&2
    exit 1
fi
[[ -f "$HOME/Projects/ros2_workspace/install/setup.bash" ]] || { echo 'Run setup_px4_workspace and both build helpers first.' >&2; exit 1; }
run_dir="$HOME/Data/sessions/$(date +%Y%m%d-%H%M%S)"
mkdir -p "$run_dir"
failed=1
cleanup() {
    if (( failed )); then
        # A stopped/failed startup may still have a readiness waiter. Its EXIT
        # trap must not kill a newer session created under the same name.
        current_run=$(tmux show-environment -t "$session" PX4_DEV_RUN_DIR 2>/dev/null || true)
        if [[ $current_run == "PX4_DEV_RUN_DIR=$run_dir" ]]; then
            tmux kill-session -t "$session" 2>/dev/null || true
        fi
        echo "Session startup failed. Logs: $run_dir" >&2
    fi
}
trap cleanup EXIT
tmux new-session -d -s "$session" -n agent 'exec bash -lc "start_micro_xrce_agent"'
tmux set-environment -t "$session" PX4_DEV_RUN_DIR "$run_dir"
# An existing tmux server retains its original environment. Forward overrides
# from this invocation to the new simulation window explicitly.
for variable in PX4_HOME_LAT PX4_HOME_LON PX4_HOME_ALT PX4_SENSOR_SUITE PX4_GZ_WORLD PX4_GZ_MODEL_POSE; do
    if [[ -v $variable ]]; then
        tmux set-environment -t "$session" "$variable" "${!variable}"
    else
        tmux set-environment -r -t "$session" "$variable"
    fi
done
tmux set-option -t "$session" remain-on-exit on
tmux pipe-pane -o -t "$session:agent" "cat >> '$run_dir/agent.log'"
# Start the world/vehicle first; attaching the GUI afterward avoids an initial
# empty scene snapshot and keeps GUI diagnostics in their own pane/log.
sim_command='start_px4_sitl --headless'
if (( !headless )); then sim_command+=' --console'; fi
tmux new-window -t "$session" -n sitl "exec bash -lc '$sim_command'"
tmux set-option -t "$session:sitl" remain-on-exit on
tmux pipe-pane -o -t "$session:sitl" "cat >> '$run_dir/sitl.log'"
# This confirms a valid position and status, not merely the existence of DDS topics.
ros2 run px4_dev_examples telemetry --once --timeout 90
for window in agent sitl; do
    [[ $(tmux display-message -p -t "$session:$window" '#{pane_dead}') == 0 ]] || { echo "$window exited" >&2; exit 1; }
done
if [[ $PX4_SENSOR_SUITE == rgbd_lidar ]]; then
    tmux new-window -t "$session" -n sensors 'exec bash -lc "ros2 launch px4_dev_examples sensors.launch.py"'
    tmux set-option -t "$session:sensors" remain-on-exit on
    tmux pipe-pane -o -t "$session:sensors" "cat >> '$run_dir/sensors.log'"
    ros2 run px4_dev_examples sensor_check --timeout 45 > "$run_dir/sensor-check.json"
fi
if (( !headless && gazebo_gui )); then
    tmux new-window -t "$session" -n gazebo 'exec bash -lc "start_gazebo_gui"'
    tmux set-option -t "$session:gazebo" remain-on-exit on
    tmux pipe-pane -o -t "$session:gazebo" "cat >> '$run_dir/gazebo.log'"
fi
if (( !headless )); then
    tmux new-window -t "$session" -n qgc 'exec bash -lc "start_qgroundcontrol"'
    tmux set-option -t "$session:qgc" remain-on-exit on
    tmux pipe-pane -o -t "$session:qgc" "cat >> '$run_dir/qgc.log'"
fi
tmux new-window -t "$session" -n ros 'exec bash -l'
tmux select-window -t "$session:sitl"
failed=0
printf 'Session ready. Logs: %s\nAttach: tmux attach -t px4-dev\nStop: stop_px4_dev\n' "$run_dir"
if (( attach )) && [[ -t 0 ]]; then tmux attach -t "$session"; fi
